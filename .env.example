# Copy to .env (git-ignored AND .dockerignore-d). Real env vars override this file.
# --- model provider: auto | offline | anthropic | openai ------------------------------------
FOGHORN_PROVIDER=offline          # offline (default, deterministic, free) | auto | anthropic | openai. Real models are opt-in.
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# FOGHORN_MODEL_FAST=claude-haiku-5-5      # per-role overrides (defaults shown in docs/design)
# FOGHORN_MODEL_SMART=claude-sonnet-5-5
# FOGHORN_MODEL_JUDGE=claude-opus-5-5
FOGHORN_LLM_MAX_TOKENS=4096        # always set; Claude 5 default is 128000
FOGHORN_LLM_TIMEOUT_S=60
FOGHORN_OFFLINE_TOKEN_DELAY_S=0.03 # makes offline token streaming visible in Studio/dashboard
# --- LangSmith (optional). Tracing is OFF unless you opt in -------------------------------
LANGSMITH_TRACING=false
# LANGSMITH_API_KEY=
# LANGSMITH_PROJECT=foghorn-dev
# LANGSMITH_HIDE_INPUTS=true           # redact prompts in traces (also HIDE_OUTPUTS / HIDE_METADATA)
# --- web / security ---------------------------------------------------------------------------
FOGHORN_ENVIRONMENT=dev
FOGHORN_LOG_LEVEL=INFO
FOGHORN_LOG_JSON=false
FOGHORN_WEBHOOK_SECRET=change-me-in-real-envs
# FOGHORN_DASHBOARD_API_TOKEN=             # unset => auth handler is permissive (dev only)
# --- Agent Server ---------------------------------------------------------------------------------
# How long a finished run's stream stays replayable (the incident console re-plays narration from it). Default is 120 s.
RESUMABLE_STREAM_TTL_SECONDS=7200
